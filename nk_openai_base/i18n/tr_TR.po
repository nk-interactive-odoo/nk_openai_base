#. module: nk_openai_base
#: model:ir.model.fields,field_description:nk_openai_base.field_res_config_settings__openai_model
msgid "OpenAI Model"
msgstr "OpenAI Modeli"

#. module: nk_openai_base
#: model:ir.model.fields,field_description:nk_openai_base.field_res_config_settings__openai_model_custom
msgid "Custom Model Name"
msgstr "Özel Model Adı"

#. module: nk_openai_base
#: model:ir.model.fields,field_description:nk_openai_base.field_res_config_settings__openai_base_url
msgid "OpenAI Base URL"
msgstr "OpenAI Temel URL"

#. module: nk_openai_base
#: model:ir.model.fields,field_description:nk_openai_base.field_res_config_settings__openai_timeout
msgid "API Timeout (seconds)"
msgstr "API Zaman Aşımı (saniye)"

#. module: nk_openai_base
#: model:ir.model.fields,field_description:nk_openai_base.field_res_config_settings__openai_max_tokens
msgid "Max Tokens"
msgstr "Maks. Token"

#. module: nk_openai_base
#: model:ir.model.fields,field_description:nk_openai_base.field_res_config_settings__openai_organization_id
msgid "OpenAI Organization ID"
msgstr "OpenAI Organizasyon ID"

#. module: nk_openai_base
#: model:ir.model.fields,field_description:nk_openai_base.field_res_config_settings__openai_project_id
msgid "OpenAI Project ID"
msgstr "OpenAI Proje ID"

#. module: nk_openai_base
#: model:ir.model.fields,field_description:nk_openai_base.field_res_config_settings__openai_api_type
msgid "API Type"
msgstr "API Türü"

#. module: nk_openai_base
#: model:ir.model.fields,help:nk_openai_base.field_res_config_settings__openai_enabled
msgid "Enable AI-powered features using OpenAI API"
msgstr "OpenAI API kullanarak AI destekli özellikleri etkinleştir"

#. module: nk_openai_base
#: model:ir.model.fields,help:nk_openai_base.field_res_config_settings__openai_api_key
msgid "Your OpenAI API key. Get it from https://platform.openai.com/api-keys"
msgstr "OpenAI API anahtarınız. https://platform.openai.com/api-keys adresinden alın"

#. module: nk_openai_base
#: model:ir.model.fields,help:nk_openai_base.field_res_config_settings__openai_model
msgid "Select the OpenAI model to use. Rate limits shown as (TPM, RPM). TPM = Tokens Per Minute, RPM = Requests Per Minute. Higher TPM/RPM = faster processing but may cost more."
msgstr "Kullanılacak OpenAI modelini seçin. Hız sınırları (TPM, RPM) olarak gösterilir. TPM = Dakika Başına Token, RPM = Dakika Başına İstek. Daha yüksek TPM/RPM = daha hızlı işleme ancak daha pahalı olabilir."

#. module: nk_openai_base
#: model:ir.model.fields,help:nk_openai_base.field_res_config_settings__openai_model_custom
msgid "Enter a custom model name if not listed above. Leave empty to use the selected model from the dropdown. This is useful for custom deployments or new model versions."
msgstr "Yukarıda listelenmemişse özel bir model adı girin. Açılır menüden seçilen modeli kullanmak için boş bırakın. Bu, özel dağıtımlar veya yeni model sürümleri için yararlıdır."

#. module: nk_openai_base
#: model:ir.model.fields,help:nk_openai_base.field_res_config_settings__openai_base_url
msgid "Base URL for OpenAI API. Use default for OpenAI, or custom URL for compatible APIs (e.g., Ollama, LocalAI)"
msgstr "OpenAI API için temel URL. OpenAI için varsayılanı kullanın veya uyumlu API'ler için özel URL (örn. Ollama, LocalAI)"

#. module: nk_openai_base
#: model:ir.model.fields,help:nk_openai_base.field_res_config_settings__openai_timeout
msgid "Timeout in seconds for OpenAI API requests"
msgstr "OpenAI API istekleri için saniye cinsinden zaman aşımı"

#. module: nk_openai_base
#: model:ir.model.fields,help:nk_openai_base.field_res_config_settings__openai_max_tokens
msgid "Maximum number of tokens in the API response"
msgstr "API yanıtındaki maksimum token sayısı"

#. module: nk_openai_base
#: model:ir.model.fields,help:nk_openai_base.field_res_config_settings__openai_organization_id
msgid "Optional: Organization ID for API requests. Found in your organization settings page. Leave empty if not using multiple organizations."
msgstr "İsteğe bağlı: API istekleri için organizasyon ID. Organizasyon ayarları sayfanızda bulunur. Birden fazla organizasyon kullanmıyorsanız boş bırakın."

#. module: nk_openai_base
#: model:ir.model.fields,help:nk_openai_base.field_res_config_settings__openai_project_id
msgid "Optional: Project ID for API requests. Found in your project general settings. Leave empty if not using projects."
msgstr "İsteğe bağlı: API istekleri için proje ID. Projenizin genel ayarlarında bulunur. Proje kullanmıyorsanız boş bırakın."

#. module: nk_openai_base
#: model:ir.model.fields,help:nk_openai_base.field_res_config_settings__openai_api_type
msgid "Choose which OpenAI API to use. Responses API supports advanced features like tools, file search, and structured outputs. Chat Completions API is the traditional API."
msgstr "Hangi OpenAI API'sini kullanacağınızı seçin. Responses API, araçlar, dosya arama ve yapılandırılmış çıktılar gibi gelişmiş özellikleri destekler. Chat Completions API geleneksel API'dir."

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "OpenAI Configuration"
msgstr "OpenAI Yapılandırması"

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "Enable OpenAI Integration"
msgstr "OpenAI Entegrasyonunu Etkinleştir"

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "Your OpenAI API key. Get it from https://platform.openai.com/api-keys"
msgstr "OpenAI API anahtarınız. https://platform.openai.com/api-keys adresinden alın"

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "API Key"
msgstr "API Anahtarı"

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "Select the OpenAI model to use. Rate limits shown as (TPM, RPM). TPM = Tokens Per Minute, RPM = Requests Per Minute. Higher limits allow faster processing. GPT-4 series provides better quality, GPT-3.5 Turbo is faster and cheaper. O-series models are optimized for reasoning tasks."
msgstr "Kullanılacak OpenAI modelini seçin. Hız sınırları (TPM, RPM) olarak gösterilir. TPM = Dakika Başına Token, RPM = Dakika Başına İstek. Daha yüksek sınırlar daha hızlı işlemeye izin verir. GPT-4 serisi daha iyi kalite sağlar, GPT-3.5 Turbo daha hızlı ve ucuzdur. O serisi modeller akıl yürütme görevleri için optimize edilmiştir."

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "Enter a custom model name if your model is not in the list above. Leave empty to use the selected model. Useful for custom deployments, new model versions, or compatible APIs (Ollama, LocalAI, etc.)."
msgstr "Modeliniz yukarıdaki listede yoksa özel bir model adı girin. Seçilen modeli kullanmak için boş bırakın. Özel dağıtımlar, yeni model sürümleri veya uyumlu API'ler (Ollama, LocalAI vb.) için yararlıdır."

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "Base URL for OpenAI API. Use default for OpenAI, or custom URL for compatible APIs (e.g., Ollama, LocalAI)"
msgstr "OpenAI API için temel URL. OpenAI için varsayılanı kullanın veya uyumlu API'ler için özel URL (örn. Ollama, LocalAI)"

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "Timeout in seconds for OpenAI API requests"
msgstr "OpenAI API istekleri için saniye cinsinden zaman aşımı"

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "Choose which OpenAI API to use. Responses API supports advanced features like tools, file search, and structured outputs. Chat Completions API is the traditional API."
msgstr "Hangi OpenAI API'sini kullanacağınızı seçin. Responses API, araçlar, dosya arama ve yapılandırılmış çıktılar gibi gelişmiş özellikleri destekler. Chat Completions API geleneksel API'dir."

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "Maximum number of tokens in the API response"
msgstr "API yanıtındaki maksimum token sayısı"

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "Optional: Your OpenAI Organization ID. Found in your organization settings page. Only needed if you belong to multiple organizations or use projects."
msgstr "İsteğe bağlı: OpenAI Organizasyon ID'niz. Organizasyon ayarları sayfanızda bulunur. Yalnızca birden fazla organizasyona ait olmanız veya proje kullanmanız durumunda gereklidir."

#. module: nk_openai_base
#: model_terms:ir.ui.view,arch_db:nk_openai_base.view_openai_settings_form
msgid "Optional: Your OpenAI Project ID. Found in your project general settings. Only needed if you use projects to organize API usage."
msgstr "İsteğe bağlı: OpenAI Proje ID'niz. Projenizin genel ayarlarında bulunur. API kullanımını organize etmek için proje kullanıyorsanız gereklidir."

#. module: nk_openai_base
#: code:addons/nk_openai_base/models/openai_settings.py:0
#, python-format
msgid "OpenAI API key is required when OpenAI integration is enabled."
msgstr "OpenAI entegrasyonu etkinleştirildiğinde OpenAI API anahtarı gereklidir."

#. module: nk_openai_base
#: code:addons/nk_openai_base/models/openai_settings.py:0
#, python-format
msgid "Base URL must start with http:// or https://"
msgstr "Temel URL http:// veya https:// ile başlamalıdır"

#. module: nk_openai_base
#: code:addons/nk_openai_base/models/openai_settings.py:0
#, python-format
msgid "Invalid Base URL format. Must be a valid URL (e.g., https://api.openai.com/v1)"
msgstr "Geçersiz Temel URL formatı. Geçerli bir URL olmalıdır (örn. https://api.openai.com/v1)"

#. module: nk_openai_base
#: code:addons/nk_openai_base/models/openai_settings.py:0
#, python-format
msgid "API timeout must be at least 10 seconds."
msgstr "API zaman aşımı en az 10 saniye olmalıdır."

#. module: nk_openai_base
#: code:addons/nk_openai_base/models/openai_settings.py:0
#, python-format
msgid "Max tokens must be at least 100."
msgstr "Maksimum token sayısı en az 100 olmalıdır."

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "OpenAI is not enabled. Please configure OpenAI API key in Settings."
msgstr "OpenAI etkin değil. Lütfen Ayarlar'da OpenAI API anahtarını yapılandırın."

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "OpenAI API key is not configured. Please set it in Settings."
msgstr "OpenAI API anahtarı yapılandırılmamış. Lütfen Ayarlar'da ayarlayın."

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "OpenAI Base URL is not configured. Please set it in Settings."
msgstr "OpenAI Temel URL yapılandırılmamış. Lütfen Ayarlar'da ayarlayın."

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "Invalid Base URL format: %s. Must be a valid URL (e.g., https://api.openai.com/v1)"
msgstr "Geçersiz Temel URL formatı: %s. Geçerli bir URL olmalıdır (örn. https://api.openai.com/v1)"

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "Invalid Base URL: %s. Error: %s"
msgstr "Geçersiz Temel URL: %s. Hata: %s"

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "The selected model may not support the Responses API. Try switching to \"Chat Completions API\" in Settings, or use a compatible model (gpt-4.1, gpt-5, o1, o3, o4)."
msgstr "Seçilen model Responses API'yi desteklemeyebilir. Ayarlar'da \"Chat Completions API\"'ye geçmeyi deneyin veya uyumlu bir model kullanın (gpt-4.1, gpt-5, o1, o3, o4)."

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "OpenAI API request timed out. Please try again or increase the timeout in Settings."
msgstr "OpenAI API isteği zaman aşımına uğradı. Lütfen tekrar deneyin veya Ayarlar'da zaman aşımını artırın."

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "Failed to connect to OpenAI API. Please check your internet connection."
msgstr "OpenAI API'ye bağlanılamadı. Lütfen internet bağlantınızı kontrol edin."

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "OpenAI API authentication failed. Please check your API key in Settings."
msgstr "OpenAI API kimlik doğrulaması başarısız oldu. Lütfen Ayarlar'daki API anahtarınızı kontrol edin."

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "OpenAI API payment required. Please check your OpenAI account billing."
msgstr "OpenAI API ödemesi gereklidir. Lütfen OpenAI hesap faturalamanızı kontrol edin."

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "OpenAI API server error. Please try again later."
msgstr "OpenAI API sunucu hatası. Lütfen daha sonra tekrar deneyin."

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "OpenAI API error: %s"
msgstr "OpenAI API hatası: %s"

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "Unexpected error: %s"
msgstr "Beklenmeyen hata: %s"

#. module: nk_openai_base
#: code:addons/nk_openai_base/services/openai_service.py:0
#, python-format
msgid "OpenAI returned invalid JSON. Please try rephrasing your request."
msgstr "OpenAI geçersiz JSON döndürdü. Lütfen isteğinizi yeniden ifade etmeyi deneyin."

